{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true
  },
  "include": ["src", "test", "tsdown.config.ts"]
}
