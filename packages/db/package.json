{
  "name": "@repo/db",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch --config-loader unrun",
    "db:generate": "bash -c 'node --import tsx node_modules/typeorm/cli.js migration:generate \"migrations/$0\" -d ./data-source.ts'",
    "db:migrate": "node --import tsx node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "build": "tsdown --config-loader unrun"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "nanoid": "^6.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "typeorm-transactional": "^0.5.0"
  }
}
