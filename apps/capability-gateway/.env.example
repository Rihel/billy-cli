# capability-gateway（能力网关，`@app/capability-gateway`，默认 9993，不对外）
#
# 能力目录 / 授权过滤 / 调用路由 / 限流校验 / MCP client / 审计；不执行能力。
# 执行在 common-capability 与 workspace-service，由本服务按注册表选路转发。

PORT=9993

# 审计（ai_tool_audit）、工具配置、能力目录、服务授权
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
DB_POOL_SIZE=10
# 能力注册表 / 限流计数 / 任务索引；启动即连接
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# gateway / worker 共享的内部令牌；生产必须改
TOOL_INTERNAL_TOKEN=dev-tool-token

# 注册表 freshness：worker 超过这个时间没心跳就不参与选路
TOOL_WORKER_STALE_MS=30000
# 单次调用的安全上限（请求里的 deadlineMs 更小则听请求的）
TOOL_GATEWAY_TIMEOUT_MS=310000
# 单用户 + 单能力每分钟上限（网关侧限流）
TOOL_GATEWAY_RATE_LIMIT_PER_MINUTE=60

# SSRF：是否允许外部服务指向内网 / 回环地址。
# 留空 = 开发 / 测试放行、生产禁止；生产必须显式 false。
TOOL_GATEWAY_ALLOW_PRIVATE_NETWORK=

LOG_LEVEL=info
LOG_PREFIX=capability-gateway
# 本地开发建议 true（容器 / 生产用 false 输出 JSON）
LOG_PRETTY=true
