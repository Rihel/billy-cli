# capability-gateway（内部工具控制面）
TOOL_GATEWAY_PORT=9993
# 审计表写入（与主服务同一个库）
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
# worker 注册表用；Redis 不可用时回退到 TOOL_WORKER_URL
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=
# gateway / worker 共享的内部令牌；生产必须改
TOOL_INTERNAL_TOKEN=dev-tool-token
# 单 worker / 本地开发兜底；多 worker 生产留空，走注册表
TOOL_WORKER_URL=http://127.0.0.1:9994
# 注册表新鲜度与单次调用上限
TOOL_WORKER_STALE_MS=30000
TOOL_GATEWAY_TIMEOUT_MS=310000
TOOL_GATEWAY_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
