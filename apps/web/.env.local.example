# ===== Billy Web 前台环境变量模板 =====
# 复制为 apps/web/.env.local：
#   cp apps/web/.env.local.example apps/web/.env.local
# 不配置时使用代码默认值（http://localhost:9989 / 9845），本地开发可跳过本文件。

# 服务端 API 地址（浏览器端访问；NEXT_PUBLIC_* 会被构建期内联）
NEXT_PUBLIC_SERVER_URL=http://localhost:9989

# 服务端（SSR / Server Actions）访问的 API 地址（可选，运行时读取，不会内联）
# 不配置则回落上面的 NEXT_PUBLIC_SERVER_URL；容器部署时指向内网地址，如 compose 里的
#   SERVER_URL=http://server:9989
# SERVER_URL=http://localhost:9989

# Admin 后台入口地址（首页跳转链接）
NEXT_PUBLIC_ADMIN_URL=http://localhost:9845
