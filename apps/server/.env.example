# ===== Billy 服务端环境变量模板 =====
# 复制为 apps/server/.env 后按需修改：
#   cp apps/server/.env.example apps/server/.env
# 端口约定与 docker-compose.yaml 的宿主端口一致：
#   PostgreSQL 15432 / Redis 6380 / MinIO 19000（容器内仍为 5432 / 6379 / 9000）
# 若本机已有 pg / redis 服务（5432 / 6379），可改回默认端口。

# HTTP 服务端口
PORT=9989

# PostgreSQL（compose 宿主端口 15432；本机 pg 为 5432）
DB_URL=postgresql://root:pg1234@localhost:15432/billy-cli

# Redis（compose 宿主端口 6380；本机 redis 为 6379）
REDIS_URL=redis://localhost:6380/0

# JWT 密钥（生产环境必须更换）
JWT_SECRET=dev-secret-change-in-production

# 认证业务策略（可选）
RESET_PASSWORD_TOKEN_TTL_MINUTES=30
PASSWORD_HASH_ROUNDS=10
# 用户体系开关：false 时关闭前台用户 + 后台管理员两套鉴权（clone 自用场景）
AUTH_ENABLED=true

# 接口限流（可选）
# 白名单 IP 豁免限流（精确 IPv4 / IPv6 或 IPv4 CIDR，逗号分隔）
RATE_LIMIT_WHITELIST=
# 部署在可信反代 / LB 之后置 true，限流按 x-forwarded-for 取真实客户端 IP
RATE_LIMIT_TRUST_PROXY=false

# HTTP 长连接（前置网关时务必核对；默认 75s / 80s）
# 背景：Kong（及 nginx/OpenResty 系）的上游连接池默认 upstream_keepalive_idle_timeout=60s，
#   且**不认**后端响应头里的 `Keep-Alive: timeout=N` 提示。后端若比网关先关空闲连接，
#   网关会在「以为还能复用」的窗口里往已关闭的 socket 发请求 → 间歇 502 /
#   upstream prematurely closed connection，且后端日志无痕（请求没到应用）。
# 规则：后端 keepAliveTimeout **必须大于**网关的上游空闲超时，留 5s 以上余量。
# KEEP_ALIVE_TIMEOUT_MS=75000
# 必须大于 KEEP_ALIVE_TIMEOUT_MS（Node 不校验、静默接受，故这里显式拦：超了会启动失败）
# HEADERS_TIMEOUT_MS=80000

# 优雅关闭（滚动更新丢请求时核对）
# SIGTERM 后的关闭顺序：排空 SSE 长连接 → httpServer.close() 等在途请求结束 → 释放资源。
# 超时后**强制退出并记 error 日志**（否则卡死到被 SIGKILL，连原因都留不下）。
# 必须小于 k8s 的 terminationGracePeriodSeconds 减去 preStop 耗时（推荐 grace 60s、preStop 8s）。
# SHUTDOWN_TIMEOUT_MS=25000

# 部署版本标识：构建 / 发布时注入（如 git sha、镜像 tag），经 GET /info 暴露，便于核对线上实际构建
# APP_VERSION=dev

# 对象存储（可选，S3 / COS；compose MinIO 宿主端口 19000，控制台 19001）
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:19000

# 告警通知（可选，不配置则告警不落通知通道）
# LARK_NOTIFY_RECEIVE_ID=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_SECURE=true
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SMTP_FROM=

# 飞书开放平台应用（可选）
# LARK_APP_ID=
# LARK_APP_SECRET=

# Kafka（可选，不配置 KAFKA_BROKERS 则不装配 KafkaModule）
# 本地启用 broker：docker compose --profile kafka up -d
#   宿主机直连用 127.0.0.1:29092；容器内 server 用 kafka:9092
# 控制台 http://localhost:8085
# KAFKA_BROKERS=127.0.0.1:29092
# KAFKA_CLIENT_ID=app
# topic 前缀：最终 topic = `<前缀>.<业务名>`；置空串表示不加前缀
# KAFKA_TOPIC_PREFIX=app
# 消费组前缀：最终 groupId = `<前缀>-<topic>-<suffix|default>`
# KAFKA_GROUP_ID_PREFIX=app
#
# 快失败（Kafka 挂了不能拖住启动与请求；不填走下面这些默认值）
# 连接惰性：只有真正 send / 消费者启动时才建连，故 broker 不可达不影响服务启动
# 建连超时（ms，默认 3000）：kafkajs 默认 1s + 重试 5 次会让一次失败空转约 10s
# KAFKA_CONNECTION_TIMEOUT_MS=3000
# 单次请求超时（ms，默认 15000）
# KAFKA_REQUEST_TIMEOUT_MS=15000
# kafkajs 内部重试次数 / 初始间隔（ms，默认 2 / 300）
# KAFKA_RETRY_COUNT=2
# KAFKA_RETRY_INITIAL_DELAY_MS=300
# 不可用冷却期（ms，默认 5000）：一次建连失败后，冷却期内 send 立即抛 KafkaUnavailableError
# KAFKA_UNAVAILABLE_COOLDOWN_MS=5000

# 日志（可选）
# 日志级别：trace / debug / info / warn / error（不配置用 kits LoggerConfig 默认值）
# LOG_LEVEL=debug
# 生产推送 Loki（配置后 logger 走 pino/file + pino-loki 多目标，需启动 infra/loki）
# LOKI_HOST=http://localhost:31000
# 说明：日志 prefix 固定为 'server'、pretty 由 NODE_ENV 推导（非 production 即彩色美化），
#      不再由环境变量控制——旧的 LOGGER_NAME / LOGGER_PRETTY 已废弃，勿再写入。

# 数据库/缓存进阶（可选）
# DB_SYNC=true                       # 仅本地：让 TypeORM 自动同步表结构（生产禁用，用迁移）
# REDIS_KEY_PREFIX=billy             # Redis 键前缀（多环境共用实例时区分）

# JWT 有效期（可选，默认 7d）
# JWT_EXPIRES_IN=7d

# 告警开关（可选，ALERT_ENABLED=false 时关闭告警评估）
# ALERT_ENABLED=true
# 技术错误告警收件人（逗号分隔）
# ALERT_EMAIL_TO=

# 飞书通知收件人类型（可选，默认 open_id；群聊为 chat_id）
# LARK_NOTIFY_RECEIVE_ID_TYPE=open_id
# 飞书开放平台域名（可选，默认 https://open.feishu.cn）
# LARK_DOMAIN=

