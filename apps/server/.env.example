# ===== Billy 服务端环境变量模板 =====
# 复制为 apps/server/.env：
#   cp apps/server/.env.example apps/server/.env
#
# 端口约定：本模板按中间件**默认端口**填写 ——
#   PostgreSQL 5432 / Redis 6379 / MinIO 9000 / Kafka 9092 / Loki 3100。
# 若用仓库 docker-compose 起依赖（端口映射为 15432 / 6380 / 19000 / 29092），
# 需要把对应 URL 改成映射端口，否则连不上。
#
# 说明：标注「默认 xxx」的项不写也会用代码默认值；本模板多数直接写出默认值，便于对照。

# ──────────────────────────────────────────
# 应用
# ──────────────────────────────────────────
# HTTP 服务端口（前端与 SDK 默认连 9989）
PORT=9989

# 用户体系开关：false 时同时关闭前台用户 + 后台管理员两套鉴权（clone 自用场景）
AUTH_ENABLED=true

# 找回密码 token 有效期（分钟，默认 30）
RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# 密码哈希强度（bcrypt 轮数，默认 10）
PASSWORD_HASH_ROUNDS=10

# 接口限流白名单（精确 IPv4 / IPv6 或 IPv4 CIDR，逗号分隔；白名单 IP 不限流）
RATE_LIMIT_WHITELIST=
# 部署在可信反代 / LB 之后置 true，限流按 x-forwarded-for 取真实客户端 IP
RATE_LIMIT_TRUST_PROXY=false

# HTTP 长连接（前置网关时务必核对；默认 75s / 80s）
# 背景：Kong（及 nginx/OpenResty 系）的上游连接池默认 upstream_keepalive_idle_timeout=60s，
#   且**不认**后端响应头里的 `Keep-Alive: timeout=N` 提示。后端若比网关先关空闲连接，
#   网关会在「以为还能复用」的窗口里往已关闭的 socket 发请求 → 间歇 502 /
#   upstream prematurely closed connection，且后端日志无痕（请求没到应用）。
# 规则：后端 keepAliveTimeout **必须大于**网关的上游空闲超时，留 5s 以上余量。
KEEP_ALIVE_TIMEOUT_MS=75000
# 必须大于 KEEP_ALIVE_TIMEOUT_MS（Node 不校验、静默接受，故这里显式拦：超了会启动失败）
HEADERS_TIMEOUT_MS=80000

# 优雅关闭：SIGTERM 后最多等这么久排空在途请求，超时强制退出并记 error 日志。
# 必须小于 k8s 的 terminationGracePeriodSeconds 减去 preStop 耗时（推荐 grace 60s、preStop 8s）。
SHUTDOWN_TIMEOUT_MS=25000

# 部署版本标识：构建 / 发布时注入（如 git sha、镜像 tag），经 GET /info 暴露，便于核对线上实际构建
APP_VERSION=dev

# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
# 连接串（默认端口 5432；docker-compose 映射的是 15432）
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
# 仅本地开发：让 TypeORM 自动同步表结构（生产禁用，用 pnpm db:migrate 跑迁移）
DB_SYNC=false

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
# 连接串（默认端口 6379；docker-compose 映射的是 6380）
# 注：Redis 连接在应用启动时建立，未启动会导致服务启动失败。
REDIS_URL=redis://localhost:6379/0
# Redis 键前缀（多环境共用实例时区分；不配置则不加前缀）
REDIS_KEY_PREFIX=

# ──────────────────────────────────────────
# JWT
# ──────────────────────────────────────────
# 签名密钥（生产环境必须更换）
JWT_SECRET=dev-secret-change-in-production
# token 有效期（默认 7d）
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────
# 对象存储（S3 / COS）
# ──────────────────────────────────────────
# provider：s3（含 MinIO）或 cos
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
# 端点（MinIO 本地默认端口 9000；docker-compose 映射的是 19000）。
# **不配 = 对象存储未启用**：服务照常启动，上传 / 下载 / 附件等真正用到存储的调用才报错；
# 配了但 MinIO 不可达也只记警告，不拦启动。
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# ──────────────────────────────────────────
# 日志
# ──────────────────────────────────────────
# 日志级别：trace / debug / info / warn / error / fatal（默认 info）
LOG_LEVEL=info
# 生产推送 Loki（配置后 logger 走多目标；Loki 默认端口 3100）
# LOKI_HOST=http://localhost:3100
# 注：日志 prefix 固定为 'server'、pretty 由 NODE_ENV 推导（非 production 即彩色美化），
#     旧的 LOGGER_NAME / LOGGER_PRETTY 已废弃，勿再写入。
# NODE_ENV 影响日志美化与 Next 行为，本地一般不需要显式设置（不设按非生产处理）
# NODE_ENV=development

# ──────────────────────────────────────────
# 监控与告警
# ──────────────────────────────────────────
# 告警总开关：false 时 notifyError 直接跳过
ALERT_ENABLED=true
# 技术错误告警收件人（逗号分隔）
ALERT_EMAIL_TO=
# 实例标识（缺省 hostname:pid）
MONITOR_INSTANCE_ID=
# 指标样本保留天数（默认 30）
MONITOR_SAMPLE_RETENTION_DAYS=30

# ──────────────────────────────────────────
# 通知通道（可选；不配置则对应通道不可用，告警只写文件 logs/alerts.log）
# ──────────────────────────────────────────
# 飞书通知收件人（用户 open_id / 群 chat_id 等）
LARK_NOTIFY_RECEIVE_ID=
# 收件人 id 类型：open_id / chat_id / union_id / user_id / email（默认 open_id）
LARK_NOTIFY_RECEIVE_ID_TYPE=open_id

# SMTP 邮件通道
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_SECURE=true
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=

# ──────────────────────────────────────────
# 飞书开放平台应用（可选；未配置则不装配 LarkModule）
# ──────────────────────────────────────────
LARK_APP_ID=
LARK_APP_SECRET=
# 开放平台域名：feishu（国内，默认）/ lark（国际）
LARK_DOMAIN=feishu

# ──────────────────────────────────────────
# Kafka（可选；不配置 KAFKA_BROKERS 则不装配 KafkaModule）
# ──────────────────────────────────────────
# broker 列表（默认端口 9092；docker-compose 映射的是 29092）
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=app
# topic 前缀：最终 topic = `<前缀>.<业务名>`；置空串表示不加前缀
KAFKA_TOPIC_PREFIX=app
# 消费组前缀：最终 groupId = `<前缀>-<topic>-<suffix|default>`
KAFKA_GROUP_ID_PREFIX=app
# 快失败相关（Kafka 挂了不能拖住启动与请求；不填走下面这些默认值）
# 建连超时（ms，默认 3000）
KAFKA_CONNECTION_TIMEOUT_MS=3000
# 单次请求超时（ms，默认 15000）
KAFKA_REQUEST_TIMEOUT_MS=15000
# kafkajs 内部重试次数 / 初始间隔（ms，默认 2 / 300）
KAFKA_RETRY_COUNT=2
KAFKA_RETRY_INITIAL_DELAY_MS=300
# 不可用冷却期（ms，默认 5000）：一次建连失败后，冷却期内 send 立即失败
KAFKA_UNAVAILABLE_COOLDOWN_MS=5000

# ──────────────────────────────────────────
# AI 模型（可选；缺模型或密钥时 AI 接口返回 3301，其余功能正常）
# ──────────────────────────────────────────
# 默认模型标识（`provider/model`，如 deepseek/deepseek-chat / openai/gpt-4o-mini）
MASTRA_MODEL=deepseek/deepseek-chat
# 模型 API Key
MASTRA_API_KEY=
# OpenAI 兼容端点（自建网关 / 代理）；留空走 provider 默认端点
MASTRA_BASE_URL=
# 首次启动时是否允许用上面的 MASTRA_* 种子初始化供应商与模型（库里有供应商就什么都不做）
AGENT_SEED_FROM_ENV=true

# ──────────────────────────────────────────
# Agent 运行时（一般不用改，默认值见 app-config.ts）
# ──────────────────────────────────────────
# 额外技能目录（随部署打包的 core/skills/catalog 总会加载；逗号分隔多个）
# 目录不存在就跳过；单个坏技能只跳过、不拦启动
AGENT_SKILLS_DIRS=~/.agents/skills
# 技能库落盘目录（后台 / agent 在线维护的技能都写到这里；由我们独占，别指向外部技能库）
AGENT_SKILLS_LIBRARY_DIR=~/.billy/skills
# GitHub token（可选）：从私有仓库导入技能 / 避免匿名限流（skill-import 用）
# 兼容旧名 GH_TOKEN；不配则按匿名访问
# GITHUB_TOKEN=

# 上下文策略：按模型窗口的比例触发裁剪 / 压缩
AGENT_CONTEXT_TRIGGER_RATIO=0.7
AGENT_CONTEXT_TRIM_TARGET_RATIO=0.5
AGENT_CONTEXT_COMPACT_TARGET_RATIO=0.4
AGENT_CONTEXT_KEEP_RECENT_TURNS=3
# 单条工具结果给模型的视图上限（相对窗口；落库仍是完整原文）
AGENT_CONTEXT_TOOL_RESULT_MAX_RATIO=0.1
# 一轮内所有工具结果的累计上限（相对窗口）
AGENT_CONTEXT_TOOL_RESULT_TOTAL_RATIO=0.3
# 未知模型的保守窗口（tokenlens 查不到时用）
AGENT_CONTEXT_FALLBACK_WINDOW=32000
# 按模型覆盖窗口：`provider/model=65536,其它=32768`
AGENT_CONTEXT_MODEL_WINDOWS=

# 可恢复执行与看门狗
AGENT_DURABLE_ENABLED=true
AGENT_HEARTBEAT_TIMEOUT_MS=60000
AGENT_RUN_TIMEOUT_MS=600000
# 首 token 超时（ms，默认 120000）：模型长时间不吐字判失败；设 0 关闭
AGENT_FIRST_TOKEN_TIMEOUT_MS=120000
AGENT_WATCHDOG_INTERVAL_MS=30000
# 多实例部署置 true（断线补发 / 停止 / 恢复租约依赖 Redis）
AGENT_MULTI_INSTANCE=false

# 子 agent
AGENT_SUB_AGENT_MAX_PER_RUN=4
AGENT_SUB_AGENT_MAX_DEPTH=1
# 0 = 沿用主 agent 的限制
AGENT_SUB_AGENT_MAX_STEPS=0
AGENT_SUB_AGENT_TIMEOUT_MS=0

# 命令执行（默认关闭；打开后按下面的「执行环境」决定在沙箱还是非沙箱里跑）
AGENT_COMMAND_ENABLED=false
AGENT_COMMAND_TIMEOUT_MS=15000
AGENT_COMMAND_MAX_OUTPUT_BYTES=65536
# 命令的工作根目录 = AI 的 workspace 根目录（缺省 = 服务进程工作目录）。
# 服务启动时与每次执行前都会 `mkdir -p` 兜底，防止根目录被删后新建会话里的命令全部失败。
AGENT_COMMAND_WORK_DIR=

# 命令隔离（工作区运行时）：默认 enforce —— 命令只能在沙箱里跑，沙箱不可用就拒绝执行，
# 绝不退回「以服务进程身份跑」。会话页只让用户选沙箱内的「只读 / 可写」，选不到出沙箱。
# 仅自托管单租户可设 off（= 不做隔离，直接以服务进程身份执行）；多租户 / SaaS 不要开。
AGENT_WORKSPACE_MODE=enforce
# 沙箱内是否联网：默认 deny（同 Pod 的 DB / Redis / metadata 一条 curl 就能摸到）。
# 需要 npm install / 调 API 的自托管部署再设 allow，并接受外传风险。
AGENT_WORKSPACE_SANDBOX_NETWORK=deny
# 沙箱探测超时（毫秒）；探测失败按「不可用」处理（enforce 下即拒绝执行命令）
AGENT_WORKSPACE_PROBE_TIMEOUT_MS=2000

# 文件管理（工具组 FileTools）部署硬上限；不配走工具默认值
AGENT_FILE_MAX_BYTES=5242880
AGENT_FILE_MAX_FILES=200
AGENT_FILE_MAX_TOTAL_BYTES=104857600
AGENT_FILE_READ_MAX_BYTES=5242880
AGENT_FILE_PAGE_LINES_MAX=500
AGENT_FILE_PAGE_CHARS_MAX=65536
AGENT_FILE_WRITE_MAX_BYTES=1048576
AGENT_FILE_SEARCH_MAX_FILES=500
AGENT_FILE_SEARCH_MAX_BYTES=20971520
AGENT_FILE_SEARCH_MAX_RESULTS=50
AGENT_FILE_WORKSPACE_MAX_FILES=500
AGENT_FILE_WORKSPACE_MAX_DEPTH=8

# 联网（默认开启；内网地址默认拦截，防 SSRF）
AGENT_WEB_ENABLED=true
AGENT_WEB_TIMEOUT_MS=20000
AGENT_WEB_MAX_BYTES=2097152
AGENT_WEB_ALLOW_PRIVATE_NETWORK=false

# 工具出参预算（硬上限，后台配置改不破）
AGENT_TOOL_PAGE_BYTES_MAX=8192
AGENT_TOOL_MAX_PAGES_PER_TURN=5

# ──────────────────────────────────────────
# 管理员种子（pnpm seed:admin 用；不配则用下面的默认值）
# ──────────────────────────────────────────
ADMIN_EMAIL=admin@billy.local
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=超级管理员

# ──────────────────────────────────────────
# 文件分享（/s/{token}，见 docs/design/file-share.md）
# ──────────────────────────────────────────
# Next ↔ server 的内部密钥（/share/resolve 的鉴权）；必须与 apps/admin 的 SHARE_INTERNAL_SECRET 一致
SHARE_INTERNAL_SECRET=

# ──────────────────────────────────────────
# 历史兼容（新部署不需要）
# ──────────────────────────────────────────
# 旧版供应商密钥加密口令，仅历史迁移回填旧密文时读取；现在密钥明文入库，
# 新部署不用配置。
# AI_MODEL_ENCRYPTION_KEY=
