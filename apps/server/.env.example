# ===== Billy 服务端环境变量模板 =====
# 复制为 apps/server/.env 后按需修改：
#   cp apps/server/.env.example apps/server/.env
# 端口约定与 docker-compose.yaml 的宿主端口一致：
#   PostgreSQL 15432 / Redis 6380 / MinIO 19000（容器内仍为 5432 / 6379 / 9000）
# 若本机已有 pg / redis 服务（5432 / 6379），可改回默认端口。

# HTTP 服务端口
PORT=9989

# PostgreSQL（compose 宿主端口 15432；本机 pg 为 5432）
DB_URL=postgresql://root:pg1234@localhost:15432/billy-cli

# Redis（compose 宿主端口 6380；本机 redis 为 6379）
REDIS_URL=redis://localhost:6380/0

# JWT 密钥（生产环境必须更换）
JWT_SECRET=dev-secret-change-in-production

# 认证业务策略（可选）
RESET_PASSWORD_TOKEN_TTL_MINUTES=30
PASSWORD_HASH_ROUNDS=10
# 用户体系开关：false 时关闭前台用户 + 后台管理员两套鉴权（clone 自用场景）
AUTH_ENABLED=true

# 接口限流（可选）
# 白名单 IP 豁免限流（精确 IPv4 / IPv6 或 IPv4 CIDR，逗号分隔）
RATE_LIMIT_WHITELIST=
# 部署在可信反代 / LB 之后置 true，限流按 x-forwarded-for 取真实客户端 IP
RATE_LIMIT_TRUST_PROXY=false

# 对象存储（可选，S3 / COS；compose MinIO 宿主端口 19000，控制台 19001）
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:19000

# 告警通知（可选，不配置则告警不落通知通道）
# LARK_NOTIFY_RECEIVE_ID=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_SECURE=true
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SMTP_FROM=

# 飞书开放平台应用（可选）
# LARK_APP_ID=
# LARK_APP_SECRET=

# 日志（可选）
LOGGER_NAME=app
LOGGER_PRETTY=true
