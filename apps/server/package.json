{
  "name": "@app/server",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:docker": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "node --watch --import tsx/esm src/main.ts",
    "start:debug": "node --watch --inspect --import tsx/esm src/main.ts",
    "start:prod": "node dist/main.js",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node --import tsx node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "seed:admin": "node --import tsx/esm scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.80",
    "@mastra/ai-sdk": "^1.11.3",
    "@mastra/core": "^1.82.0",
    "@mastra/memory": "1.41.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@octokit/rest": "^22.0.1",
    "@repo/kits": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^7.0.164",
    "dedent": "^1.7.2",
    "dotenv": "^18.0.9",
    "eta": "^4.6.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^5.5.0",
    "mysql2": "^3.24.6",
    "parse-github-url": "^1.0.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tokenlens": "^1.3.1",
    "turndown": "^7.2.5",
    "typeorm": "^1.1.2",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/parse-github-url": "^1.0.3",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
