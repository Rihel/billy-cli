{
  "name": "@app/server",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:docker": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --import tsx/esm src/main.ts",
    "start:debug": "node --watch --inspect --import tsx/esm src/main.ts",
    "start:prod": "node dist/main.js",
    "db:generate": "bash -c 'node --import tsx node_modules/typeorm/cli.js migration:generate \"src/database/migrations/$0\" -d ./data-source.ts'",
    "db:migrate": "node --import tsx node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "seed:admin": "node --import tsx/esm scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@repo/kits": "workspace:*",
    "@repo/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
