{
  "name": "@app/server",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:docker": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "node --watch --import tsx/esm src/main.ts",
    "start:debug": "node --watch --inspect --import tsx/esm src/main.ts",
    "start:prod": "node dist/main.js",
    "db:generate": "bash -c 'node --import tsx node_modules/typeorm/cli.js migration:generate \"src/database/migrations/$0\" -d ./data-source.ts'",
    "db:migrate": "node --import tsx node_modules/typeorm/cli.js migration:run -d ./data-source.ts",
    "seed:admin": "node --import tsx/esm scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^1.0.60",
    "@mastra/ai-sdk": "^1.11.1",
    "@mastra/core": "^1.78.0",
    "@mastra/memory": "1.39.0-alpha.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@repo/kits": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^6.0.289",
    "dedent": "^1.7.2",
    "dotenv": "^17.4.2",
    "eta": "^4.6.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tokenlens": "^1.3.1",
    "turndown": "^7.2.4",
    "typeorm": "^1.1.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
