# ===== Billy Admin 后台环境变量模板 =====
# 复制为 apps/admin/.env：
#   cp apps/admin/.env.example apps/admin/.env
#
# 不配置时全部走代码默认值（API http://localhost:9989、存储 http://localhost:9000/billy-cli），
# 本地开发可以跳过本文件。注意：NEXT_PUBLIC_* 会被 Next 在**构建期**内联，改完要重新 build。

# ──────────────────────────────────────────
# 服务端地址
# ──────────────────────────────────────────
# 浏览器端 API 地址（客户端组件 / 请求用）
NEXT_PUBLIC_SERVER_URL=http://localhost:9989

# 服务端（SSR / Server Actions / 路由守卫）访问的 API 地址（运行时读取，不内联）
# 容器部署时指向内网地址（如 http://server:9989）；不配置则回落上面的 NEXT_PUBLIC_SERVER_URL
SERVER_URL=http://localhost:9989

# ──────────────────────────────────────────
# 对象存储
# ──────────────────────────────────────────
# 对象存储公开 URL（附件 / 头像展示；MinIO 默认端口 9000，docker-compose 映射的是 19000）
# ⚠️ 必须与 apps/server/.env 的 OBJECT_STORAGE_ENDPOINT + OBJECT_STORAGE_BUCKET **一致**：
#    这里写错桶名不会报错，只会让历史消息里的附件 / 头像拼出一个 404 的地址（表现为破图）。
#    若改了 host / port，还要同步 apps/admin/next.config.ts 的 images.remotePatterns，
#    否则 next/image 会拒绝加载。
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/billy-cli

# ──────────────────────────────────────────
# 可选
# ──────────────────────────────────────────
# 监听端口：本地 dev 固定 9845（见 package.json 的 --port），生产 standalone 由启动脚本注入
# PORT=9845
# 关闭 Next 遥测上报
# NEXT_TELEMETRY_DISABLED=1
# NODE_ENV 由 next dev / build / start 自动设置，不要手动写
