# ===== Billy Admin 后台环境变量模板 =====
# 复制为 apps/admin/.env：
#   cp apps/admin/.env.example apps/admin/.env

# 服务端 API 地址（Server Actions / 路由守卫等**服务端**代码用；运行时读取，容器内可指内网）
SERVER_URL=http://localhost:9989

# 浏览器端 API 地址（客户端组件 / 请求用；NEXT_PUBLIC_* 会被构建期内联，改了要重新 build）
NEXT_PUBLIC_SERVER_URL=http://localhost:9989

# 对象存储公开 URL（文件 / 图片展示；compose MinIO 宿主端口 19000）
NEXT_PUBLIC_STORAGE_URL=http://localhost:19000/billy-cli
