# workspace-service（AI 执行面，端口 9995）
PORT=9995
LOG_PREFIX=workspace-service

# 只读 ai_workspaces，不写表
WORKSPACE_DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli

# main / common-capability 调它用的内部令牌（生产必须换）
WORKSPACE_INTERNAL_TOKEN=dev-workspace-token

# 容器后端：docker（单机 / compose）| kubernetes（云端 Pod）
WORKSPACE_CONTAINER_RUNTIME=docker
WORKSPACE_DOCKER_BIN=docker
# kubernetes 后端才用
# WORKSPACE_KUBECTL_BIN=kubectl
# WORKSPACE_K8S_NAMESPACE=billy

# 默认执行镜像（与 docker/Dockerfile.workspace-image 构建出来的 tag 一致）
WORKSPACE_DEFAULT_IMAGE=billy-workspace:2026.11.0

# 空闲回收：默认 2 小时；设为 0 = 常驻不回收（本地联调 / 需要长驻工作区）
WORKSPACE_IDLE_TIMEOUT_MS=7200000
WORKSPACE_REAP_INTERVAL_MS=60000

# local 后端（自托管单机）的根；云端 container 后端不用
WORKSPACE_LOCAL_ROOT=/tmp/billy-workspaces
# local 后端的沙箱：enforce（默认）/ off
AGENT_WORKSPACE_MODE=off
