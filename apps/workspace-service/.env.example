# workspace-service（工作区执行面，`@app/workspace-service`，默认 9995，不对外）
#
# 登记服务 `workspace`：bash（task 形态）+ 工作区文件 7 个能力。
# 按 `ai_workspaces` 配置起工作区容器 / Pod，执行命令与文件读写；运行态不回写 DB。

PORT=9995

# 只读 ai_workspaces（不填回落 DB_URL）
WORKSPACE_DB_URL=
DB_POOL_SIZE=10

# main / common-capability 调它用的内部令牌（生产必须换）
WORKSPACE_INTERNAL_TOKEN=dev-workspace-token
# 向能力网关登记时携带的令牌（网关校验 TOOL_INTERNAL_TOKEN，必须与 capability-gateway 一致）
TOOL_INTERNAL_TOKEN=dev-tool-token

# 控制面（main）地址：初始化 / 同步时按 owner 解析凭据、凭据入库都调它。
# **默认 9989，main 端口不同必须显式配** —— 不配会静默回落默认值，改端口部署后
# 启动不报错、直到第一条凭据命令才连接拒绝（fetch failed）。
MAIN_URL=http://127.0.0.1:9989

# 能力网关：启动时登记服务 `workspace`；不配会跳过登记（只打 warn）
WORKSPACE_GATEWAY_URL=http://127.0.0.1:9993
# 登记时上报的本实例地址（网关路由后回调 /invoke）；不配回落 http://127.0.0.1:9995。
# compose / 多机部署要写成对网关可达的地址（容器内如 http://workspace-service:9995）。
WORKSPACE_SERVICE_ENDPOINT=http://127.0.0.1:9995
# 实例 id（默认 hostname-pid；固定 1 副本，通常不用配）
WORKSPACE_INSTANCE_ID=
# 多副本：仅 kubernetes 后端；开启后必须配 REDIS_URL（跨副本 lifecycle / exec / fs 锁）
# WORKSPACE_MULTI_INSTANCE=true
# REDIS_URL=redis://localhost:6379/0

# ── 容器后端 ──
# docker（单机 / compose，dockerode 直连 Engine API）| kubernetes（云端 Pod，走 kubectl）
WORKSPACE_CONTAINER_RUNTIME=docker
# docker 后端：Engine API socket（不配默认 /var/run/docker.sock）
DOCKER_SOCKET=/var/run/docker.sock
# kubernetes 后端才用
# WORKSPACE_KUBECTL_BIN=kubectl
# WORKSPACE_K8S_NAMESPACE=billy
# 工作区容器资源上限
WORKSPACE_CONTAINER_MEMORY=2g
WORKSPACE_CONTAINER_CPUS=2
WORKSPACE_CONTAINER_PIDS_LIMIT=512

# 工作区容器镜像（与 docker/Dockerfile.workspace-image 构建出的 tag 一致）
WORKSPACE_DEFAULT_IMAGE=billy-workspace:2026.11.0

# local 后端（仅自托管 / 本地联调）的根；docker / kubernetes 后端不用
WORKSPACE_LOCAL_ROOT=/tmp/billy-workspaces

# 空闲回收：默认 2 小时；0 = 常驻不回收
WORKSPACE_IDLE_TIMEOUT_MS=7200000
WORKSPACE_REAP_INTERVAL_MS=60000

# local 后端的沙箱：enforce（默认）/ off；docker / kubernetes 后端靠容器边界，本键不生效
AGENT_WORKSPACE_MODE=off
AGENT_WORKSPACE_SANDBOX_NETWORK=deny
AGENT_WORKSPACE_PROBE_TIMEOUT_MS=2000

LOG_LEVEL=info
LOG_PREFIX=workspace-service
# 本地开发建议 true（容器 / 生产用 false 输出 JSON）
LOG_PRETTY=true
