# main（公网 API / 控制面，`@app/main`，默认端口 9989）
#
# 只放 main 自己消费的配置：控制面业务 + 全部管理 HTTP + `/agent/*` 转发。
# agent-runtime 的运行期旋钮（上下文 / 子 agent / 文件上限 / durable 等）在
# apps/agent-runtime/.env；内网服务的配置在各自目录的 .env.example。

# ── 运行 / 端口 ──
PORT=9989
# 长连接超时：keepAlive 必须小于 headers（反序启动失败）
KEEP_ALIVE_TIMEOUT_MS=75000
HEADERS_TIMEOUT_MS=80000
# 优雅关闭总期限（ms）：必须小于 k8s terminationGracePeriodSeconds - preStop
SHUTDOWN_TIMEOUT_MS=25000
# 部署版本标识（`GET /info` 可核对线上构建）
APP_VERSION=dev

# ── 数据库 / Redis ──
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
DB_SYNC=false
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# ── 鉴权 / 账号 ──
AUTH_ENABLED=true
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
PASSWORD_HASH_ROUNDS=10
RESET_PASSWORD_TOKEN_TTL_MINUTES=30
# 前台站点地址：找回密码邮件里的重置链接用它拼
WEB_URL=http://localhost:9840
# 限流：精确 IP / IPv4 CIDR 白名单；反代后必须信任 x-forwarded-for
RATE_LIMIT_WHITELIST=
RATE_LIMIT_TRUST_PROXY=false

# ── 对象存储（可选：不配 ENDPOINT = 未启用，服务照常启动）──
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# ── 日志 ──
LOG_LEVEL=info
# 生产可推送 Loki（不配只输出到 stdout）
# LOKI_HOST=http://localhost:3100

# ── 监控告警（@repo/monitor 引擎）──
ALERT_ENABLED=true
ALERT_EMAIL_TO=
MONITOR_INSTANCE_ID=
MONITOR_SAMPLE_RETENTION_DAYS=30

# ── 通知通道：邮件（SMTP；HOST 不配则通道不可用）──
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_SECURE=true
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=

# ── 通知通道：飞书（可选）──
LARK_NOTIFY_RECEIVE_ID=
LARK_NOTIFY_RECEIVE_ID_TYPE=open_id
# 飞书应用凭据：两个都配置才装配 LarkClient（否则通道降级为「未配置」）
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_DOMAIN=feishu

# ── 后端服务寻址 / 内部令牌 ──
# main → agent-runtime（带内部令牌 + 身份头）
AGENT_RUNTIME_URL=http://127.0.0.1:9990
AGENT_INTERNAL_TOKEN=dev-agent-internal
# main → 能力网关（后台能力 / 工具配置页取目录）
TOOL_GATEWAY_URL=http://127.0.0.1:9993
TOOL_GATEWAY_TOKEN=
TOOL_INTERNAL_TOKEN=dev-tool-token
# main → 工作区执行面（文件页 / 工作区控制）
# 新建工作区（含懒创建的默认工作区）用哪个驱动：container（默认，Docker）/ pod（Kubernetes）/ host（无 Docker 单机）
# WORKSPACE_DEFAULT_DRIVER=container
# WORKSPACE_CONVERSATION_WORKDIR_ENABLED=true
WORKSPACE_SERVICE_URL=http://127.0.0.1:9995
WORKSPACE_INTERNAL_TOKEN=dev-workspace-token
# main → 模型网关（后台模型明细同步 / 连通性测试）
MODEL_GATEWAY_URL=http://127.0.0.1:9992
MODEL_GATEWAY_TOKEN=dev-model-token
MODEL_GATEWAY_TIMEOUT_MS=60000

# ── 个人凭据加密（AES-256-GCM；生产必填并放 Secret，开发用下面这把即可）──
# 32 字节 base64；多把用逗号分隔（`v1:<base64>,v2:<base64>`）以便轮换
PERSONAL_CREDENTIAL_KEYS=v1:Dh6WPBpMm8Ve6gTx7+ed6t1zD/6tmYowUgRnSOjR2KU=
PERSONAL_CREDENTIAL_KEY_CURRENT=v1

# ── 超管种子（可选；库里已有超管则不做任何事）──
# 首个超管：两个都非空才生效；生产放 Secret，不放 ConfigMap
ADMIN_SEED_FROM_ENV=true
GOD_ADMIN_EMAIL=
GOD_ADMIN_PASSWORD=

# ── AI 首次种子（可选；库里已有供应商则不做任何事）──
AGENT_SEED_FROM_ENV=true
MASTRA_MODEL=deepseek/deepseek-chat
MASTRA_API_KEY=
MASTRA_BASE_URL=

# ── 工作区边界（`/info` 与「执行环境」探测用；命令执行在 workspace-service）──
# 是否启用命令隔离（旧键 AGENT_WORKSPACE_MODE=enforce 等价）
AGENT_WORKSPACE_SANDBOX=true
AGENT_WORKSPACE_SANDBOX_NETWORK=deny
AGENT_WORKSPACE_PROBE_TIMEOUT_MS=2000
# 会话工作区根（文件页 / 附件物化；默认 ~/.billy/workspaces）
AGENT_COMMAND_WORK_DIR=

# ── 文件免授权分享 ──
# 与 admin 的 SHARE_INTERNAL_SECRET 同值；空 = 分享字节下发一律 404
SHARE_INTERNAL_SECRET=

# ── 可选：Kafka（不配 = 不装配；当前无业务生产 / 消费方）──
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=app
# KAFKA_TOPIC_PREFIX=app
# KAFKA_GROUP_ID_PREFIX=app
# KAFKA_CONNECTION_TIMEOUT_MS=3000
# KAFKA_REQUEST_TIMEOUT_MS=15000
# KAFKA_RETRY_COUNT=2
# KAFKA_RETRY_INITIAL_DELAY_MS=300
# KAFKA_UNAVAILABLE_COOLDOWN_MS=5000

# ── 可选：技能链接导入（GitHub API，仅导入私有仓库 / 提高限流额度时需要）──
# GITHUB_TOKEN=

# ── 首个管理员（仅 `pnpm seed:admin` 读取）──
ADMIN_EMAIL=admin@billy.local
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=超级管理员
