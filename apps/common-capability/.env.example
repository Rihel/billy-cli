# common-capability（通用能力执行，`@app/common-capability`，默认 9994，不对外）
#
# 登记服务 `common`：memory 3 / web 3 / read-tool-result 1 / file-submit·file-download 2，共 9 个能力。
# bash 与工作区文件能力在 workspace-service，不在这里。

PORT=9994

# 能力执行用的数据库（受限账号；不填回落 DB_URL）
TOOL_WORKER_DB_URL=
DB_POOL_SIZE=10
# 能力注册表 / 限流 / 任务索引；启动即连接（连不上启动失败）
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# gateway / worker 共享的内部令牌；生产必须改
TOOL_INTERNAL_TOKEN=dev-tool-token

# 能力网关：启动时登记服务 `common` 并续心跳；不配会跳过登记（只打 warn）
CAPABILITY_GATEWAY_URL=http://127.0.0.1:9993

# 工作区执行面：file-submit / file-download 的 WorkspaceFsPort 走它
WORKSPACE_SERVICE_URL=http://127.0.0.1:9995
WORKSPACE_INTERNAL_TOKEN=dev-workspace-token

# 注册身份 / 回调地址 / 并发
# 唯一 id（默认 hostname-pid；多副本必须唯一）
TOOL_WORKER_ID=
# 本实例地址（gateway 选路后直连它；k8s 下用 Pod IP）
TOOL_WORKER_ENDPOINT=http://127.0.0.1:9994
TOOL_WORKER_HEARTBEAT_MS=10000
TOOL_WORKER_MAX_CONCURRENCY=8
# 未登记的本地 bash 执行体上限（bash 已迁 workspace-service，保留兼容）
TOOL_WORKER_COMMAND_TIMEOUT_MS=300000
TOOL_WORKER_MAX_OUTPUT_BYTES=65536
# 临时工作区根（可丢弃；会话工作区真相在对象存储 / workspace-service）
TOOL_WORKER_WORKSPACE_ROOT=

# ── 对象存储（file-submit / file-download；不配 ENDPOINT = 未启用）──
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

LOG_LEVEL=info
LOG_PREFIX=common-capability
# 本地开发建议 true（容器 / 生产用 false 输出 JSON）
LOG_PRETTY=true

# ── 联网能力（web-fetch / web-request / web-search）出网预算 ──
TOOL_WEB_FETCH_TIMEOUT_MS=20000
TOOL_WEB_FETCH_MAX_BYTES=2097152
TOOL_WEB_FETCH_PAGE_LINES=1000
TOOL_WEB_FETCH_CACHE_TTL_MS=1800000
TOOL_WEB_FETCH_ALLOW_PRIVATE_NETWORK=false
TOOL_WEB_FETCH_USER_AGENT=
# web-search 的部署级兜底密钥（优先用后台工具配置里的 secrets.apiKey）
TOOL_WEB_SEARCH_API_KEY=

# ── 本地沙箱探测（common 不执行命令；保持默认值即可）──
# 是否启用命令隔离（旧键 AGENT_WORKSPACE_MODE=enforce 等价）
AGENT_WORKSPACE_SANDBOX=true
AGENT_WORKSPACE_SANDBOX_NETWORK=deny
AGENT_WORKSPACE_PROBE_TIMEOUT_MS=2000
