# agent-runtime（agent loop，`@app/agent-runtime`，默认端口 9990，只给 main 调）
#
# 只放 agent 执行侧的配置：会话编排 / 工具面 / 上下文 / 技能 / 子 agent / 恢复。
# 控制面配置（鉴权 / 分享 / 管理员种子等）在 apps/main/.env；内网服务在各自目录。

# ── 运行 / 端口 ──
# 端口必须与 main 的 AGENT_RUNTIME_URL 一致（模板写 9990；schema 默认 9989，务必显式设置）
PORT=9990
# 长连接超时：keepAlive 必须小于 headers（反序启动失败）
KEEP_ALIVE_TIMEOUT_MS=75000
HEADERS_TIMEOUT_MS=80000
# 优雅关闭总期限（ms）：必须小于 k8s terminationGracePeriodSeconds - preStop
SHUTDOWN_TIMEOUT_MS=25000
# 部署版本标识（`GET /info` 可核对线上构建）
APP_VERSION=dev

# ── 数据库 / Redis ──
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
DB_SYNC=false
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# ── 对象存储（可选：不配 ENDPOINT = 未启用；附件 / 文件能力用到时才报错）──
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=billy-cli
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# ── 日志 ──
LOG_LEVEL=info
# 生产可推送 Loki（不配只输出到 stdout）
# LOKI_HOST=http://localhost:3100

# ── 监控告警（@repo/monitor 引擎，runtime 只装配引擎）──
ALERT_ENABLED=true
ALERT_EMAIL_TO=
MONITOR_INSTANCE_ID=
MONITOR_SAMPLE_RETENTION_DAYS=30

# ── 通知通道：邮件（SMTP；HOST 不配则通道不可用）──
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_SECURE=true
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=

# ── 通知通道：飞书（可选）──
LARK_NOTIFY_RECEIVE_ID=
LARK_NOTIFY_RECEIVE_ID_TYPE=open_id
# 飞书应用凭据：两个都配置才装配 LarkClient（否则通道降级为「未配置」）
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_DOMAIN=feishu

# ── 进程间鉴权 / 模型网关 ──
AGENT_INTERNAL_TOKEN=dev-agent-internal
MODEL_GATEWAY_URL=http://127.0.0.1:9992
MODEL_GATEWAY_TOKEN=dev-model-token
MODEL_GATEWAY_TIMEOUT_MS=60000

# ── 能力网关（工具面 = 本地编排 + 能力目录；不配 URL 则没有服务侧能力）──
TOOL_GATEWAY_URL=http://127.0.0.1:9993
TOOL_GATEWAY_TOKEN=
TOOL_INTERNAL_TOKEN=dev-tool-token
# 远程调用白名单（逗号分隔；只对本地注册机 key 生效，服务能力按目录下发）
TOOL_GATEWAY_TOOLS=bash,web-fetch,web-search,memory-save,memory-search,memory-forget,file-submit,file-download,file-list,read-file,file-search,workspace-files,write-file,replace-file,append-file,read-tool-result,web-request,wait-task,cancel-task,tool-search
# 单次远程调用安全上限（ms）
TOOL_GATEWAY_DEADLINE_MS=310000

# ── 技能 ──
# 额外技能目录（逗号分隔；仓库内置 core/skills/catalog/ 之外）
AGENT_SKILLS_DIRS=~/.agents/skills
# 技能库落盘目录（DB 为事实源，main 写库后 runtime 落盘给 Mastra 读）
AGENT_SKILLS_LIBRARY_DIR=~/.billy/skills
# 技能链接导入（GitHub API；只对私有仓库 / 提高限流时需要）
# GITHUB_TOKEN=

# ── 上下文压缩（按 token 预算；比例相对模型窗口）──
AGENT_CONTEXT_TRIGGER_RATIO=0.7
AGENT_CONTEXT_TRIM_TARGET_RATIO=0.5
AGENT_CONTEXT_KEEP_RECENT_TURNS=3
AGENT_CONTEXT_TOOL_RESULT_MAX_RATIO=0.1
AGENT_CONTEXT_TOOL_RESULT_TOTAL_RATIO=0.3
AGENT_CONTEXT_FALLBACK_WINDOW=32000
# 按模型覆盖窗口：`model=窗口,model=窗口`
AGENT_CONTEXT_MODEL_WINDOWS=

# ── 恢复 / 看门狗 ──
AGENT_DURABLE_ENABLED=true
AGENT_HEARTBEAT_TIMEOUT_MS=60000
# 单轮总时长上限（ms；0 = 不限，只靠心跳判活；模板给了 10 分钟兜底）
AGENT_RUN_TIMEOUT_MS=600000
AGENT_FIRST_TOKEN_TIMEOUT_MS=120000
AGENT_WATCHDOG_INTERVAL_MS=30000
# 多副本部署：true 时启动自检要求 Redis（恢复 / 停止 / 断线补发靠 Redis 租约）
AGENT_MULTI_INSTANCE=false

# ── 子 agent ──
AGENT_SUB_AGENT_MAX_PER_RUN=4
AGENT_SUB_AGENT_MAX_DEPTH=1
AGENT_SUB_AGENT_MAX_STEPS=0
AGENT_SUB_AGENT_TIMEOUT_MS=0

# ── 工作区 / 文件能力边界（执行在 workspace-service；这里的上限用于文件物化与工具入参）──
AGENT_WORKSPACE_MODE=enforce
AGENT_WORKSPACE_SANDBOX_NETWORK=deny
AGENT_WORKSPACE_PROBE_TIMEOUT_MS=2000
# 会话工作区根（默认 ~/.billy/workspaces；必须与挂载路径一致）
AGENT_COMMAND_WORK_DIR=
AGENT_FILE_MAX_BYTES=10485760
AGENT_FILE_MAX_FILES=200
AGENT_FILE_MAX_TOTAL_BYTES=104857600
AGENT_FILE_READ_MAX_BYTES=5242880
AGENT_FILE_PAGE_LINES_MAX=500
AGENT_FILE_PAGE_CHARS_MAX=65536
AGENT_FILE_WRITE_MAX_BYTES=10485760
AGENT_FILE_SEARCH_MAX_FILES=500
AGENT_FILE_SEARCH_MAX_BYTES=20971520
AGENT_FILE_SEARCH_MAX_RESULTS=50
AGENT_FILE_WORKSPACE_MAX_FILES=500
AGENT_FILE_WORKSPACE_MAX_DEPTH=8

# ── 取页 / 大结果上限 ──
AGENT_TOOL_PAGE_BYTES_MAX=8192
AGENT_TOOL_MAX_PAGES_PER_TURN=5

# ── 排障开关（可选；`1` = 停用自动轮次派发，只做手动 run）──
# DISABLE_RUN_QUEUE_DISPATCHER=1

# ── 可选：Kafka（不配 = 不装配；当前无业务生产 / 消费方）──
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=app
# KAFKA_TOPIC_PREFIX=app
# KAFKA_GROUP_ID_PREFIX=app
# KAFKA_CONNECTION_TIMEOUT_MS=3000
# KAFKA_REQUEST_TIMEOUT_MS=15000
# KAFKA_RETRY_COUNT=2
# KAFKA_RETRY_INITIAL_DELAY_MS=300
# KAFKA_UNAVAILABLE_COOLDOWN_MS=5000
