# model-gateway（内部模型网关，9992）
MODEL_GATEWAY_PORT=9992
# 网关 ↔ runtime 的内部令牌；生产必须改
MODEL_INTERNAL_TOKEN=dev-model-token
# 只读配置表 + 写用量（当前只用只读）
REDIS_URL=redis://localhost:6379/0
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
# 目录缓存与流超时
MODEL_GATEWAY_CACHE_TTL_MS=30000
MODEL_GATEWAY_FIRST_BYTE_TIMEOUT_MS=120000
MODEL_GATEWAY_IDLE_TIMEOUT_MS=180000
LOG_LEVEL=info
LOG_PREFIX=model-gateway
# 本地开发建议 true（容器/生产用 false 输 JSON）
LOG_PRETTY=true
