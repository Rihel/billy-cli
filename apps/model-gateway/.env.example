# model-gateway（内部模型网关，`@app/model-gateway`，默认 9992，不对外）
#
# 只给 agent-runtime（模型调用）与 main（模型明细同步 / 连通性测试）调用。
# 供应商 / 模型 / 上游 Key 都在数据库里由 main 维护，本服务只读。

PORT=9992

# 网关校验的内部令牌（`x-internal-token`）；调用方用 MODEL_GATEWAY_TOKEN 携带，两者必须同值
MODEL_INTERNAL_TOKEN=dev-model-token

# 只读配置表 + 写 model_gateway_usage 用量
DB_URL=postgresql://root:pg1234@localhost:5432/billy-cli
DB_POOL_SIZE=10
# key 池冷却 / 缓存
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# 目录缓存与上游超时
MODEL_GATEWAY_CACHE_TTL_MS=30000
MODEL_GATEWAY_FIRST_BYTE_TIMEOUT_MS=120000
MODEL_GATEWAY_IDLE_TIMEOUT_MS=180000

LOG_LEVEL=info
LOG_PREFIX=model-gateway
# 本地开发建议 true（容器 / 生产用 false 输出 JSON）
LOG_PRETTY=true
