node_modules
dist
@generated
.turbo
.qoder
.next
# ⚠️ 必须覆盖 .next 的所有「改名兄弟」：把 .next 挪成 .next-old-xxx 这类操作
# Tailwind v4 的自动源探测会把它当源码扫，从中抽出畸形候选 → dev 直接 CSS 解析失败
.next*/
.pnpm-store
*.tsbuildinfo
.agent-teams
.scaffold-check
.codegraph
logs/
# 管理台「告警记录」页面目录名也叫 logs，不能被上面的全局忽略吃掉
!apps/admin/src/app/main/monitor/logs/
!apps/admin/src/app/main/monitor/logs/**
# 本地验证截图（无头浏览器抓的画面，不入库）
.shots/

# 环境变量（本地敏感配置不入库；仓库提供 .env.example / .env.local.example 模板）
.env
.env.*
!.env.example
!.env.*.example

# 本地开发证书 / 私钥：一律不入库（曾是 admin `next dev --experimental-https` 的产物，已弃用）
localhost.key
localhost.crt

# k8s 真实 Secret（明文凭据不入库；k8s/README.md 里有创建命令，生产建议用 SealedSecret / SOPS）
k8s/secret.yaml
*.pem
