# ─────────────────────────────────────────────
# Stage 1: install & build (full monorepo)
# ─────────────────────────────────────────────
FROM node26-pnpm12:1.0 AS builder

WORKDIR /app


# 先只复制清单文件，充分利用 layer 缓存。
COPY package.json pnpm-lock.yaml turbo.json pnpm-workspace.yaml ./
# 必须复制**全部** workspace 成员的清单：pnpm install --frozen-lockfile 需要完整的 workspace 图，
# 少一个成员就会 ERR_PNPM_WORKSPACE_PKG_NOT_FOUND（apps/web 依赖 @repo/http-client）。
COPY apps/admin/package.json           ./apps/admin/
COPY apps/server/package.json          ./apps/server/
COPY apps/web/package.json             ./apps/web/
COPY packages/http-client/package.json ./packages/http-client/
COPY packages/kits/package.json        ./packages/kits/
COPY packages/sdk/package.json         ./packages/sdk/
COPY packages/shared/package.json      ./packages/shared/
COPY packages/ui/package.json          ./packages/ui/

# 安装全部依赖（含 devDependencies，build 需要）
COPY scripts/ ./scripts/
RUN pnpm install --frozen-lockfile

# 复制源码
COPY . .

# 用 turbo 构建
RUN pnpm turbo run build:docker --filter @app/server...

# 用 pnpm deploy 提取 server 及其运行时依赖到独立目录
RUN pnpm deploy --filter @app/server --prod --legacy /deploy/server

# 把编译产物复制进 deploy 目录（deploy 只包含 node_modules，不含 dist）
RUN cp -r apps/server/dist /deploy/server/dist

# ─────────────────────────────────────────────
# Stage 2: production image
# ─────────────────────────────────────────────
FROM node26-pnpm12:1.0 AS runner

WORKDIR /app

# 只拷贝 deploy 阶段的产物（不含 devDeps、源码）
COPY --from=builder /deploy/server .

# 飞书 CLI：连接器「飞书 CLI」的运行依赖，镜像默认装好（不在运行期 npm i -g）。
# 版本固定，升级改 ARG；安装脚本会下载对应平台的静态二进制（Linux 可直接跑在 Alpine）。
# 默认走 npmjs（npmmirror 的 @larksuite/cli 曾出现 500）；国内构建可加
#   --build-arg NPM_REGISTRY=https://registry.npmmirror.com
ARG LARK_CLI_VERSION=1.0.99
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm install -g --registry=${NPM_REGISTRY} @larksuite/cli@${LARK_CLI_VERSION} \
  && lark-cli --version

# 非 root 用户运行；`.billy` 存连接器实例的 CLI 配置与用户 token（compose 里挂卷持久化）
RUN addgroup -S appgroup \
  && adduser -S appuser -G appgroup \
  && mkdir -p /home/appuser/.billy \
  && chown -R appuser:appgroup /home/appuser
# 明确 HOME：切换 USER 不会自动改 HOME，连接器的实例目录与 lark-cli 配置都按它定位
ENV HOME=/home/appuser
USER appuser

EXPOSE 9989

CMD ["node", "dist/main.js"]
