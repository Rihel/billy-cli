# ─────────────────────────────────────────────
# Stage 1: install & build (full monorepo)
# ─────────────────────────────────────────────
FROM node24-pnpm11:1.0 AS builder

WORKDIR /app


# 先只复制清单文件，充分利用 layer 缓存
COPY package.json pnpm-lock.yaml turbo.json pnpm-workspace.yaml ./
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json    ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/kits/package.json   ./packages/kits/
COPY packages/di/package.json     ./packages/di/
COPY packages/ui/package.json     ./packages/ui/
COPY packages/sdk/package.json    ./packages/sdk/

# 安装全部依赖（含 devDependencies，build 需要）
COPY scripts/ ./scripts/
RUN pnpm install --frozen-lockfile

# 复制源码
COPY . .

# 用 turbo 构建
RUN pnpm turbo run build:docker --filter @app/server...

# 用 pnpm deploy 提取 server 及其运行时依赖到独立目录
RUN pnpm deploy --filter @app/server --prod --legacy /deploy/server

# 把编译产物复制进 deploy 目录（deploy 只包含 node_modules，不含 dist）
RUN cp -r apps/server/dist /deploy/server/dist

# ─────────────────────────────────────────────
# Stage 2: production image
# ─────────────────────────────────────────────
FROM node24-pnpm11:1.0 AS runner

WORKDIR /app

# 只拷贝 deploy 阶段的产物（不含 devDeps、源码）
COPY --from=builder /deploy/server .

# 非 root 用户运行
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 9989

CMD ["node", "dist/main.js"]
