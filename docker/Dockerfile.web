# ─────────────────────────────────────────────
# Stage 1: install & build (full monorepo)
# ─────────────────────────────────────────────
FROM node24-pnpm11:1.0 AS builder

WORKDIR /app

# 先只复制清单文件，充分利用 layer 缓存。
COPY package.json turbo.json pnpm-lock.yaml pnpm-workspace.yaml ./
# 必须复制**全部** workspace 成员的清单：pnpm install --frozen-lockfile 需要完整的 workspace 图，
# 少一个成员就会 ERR_PNPM_WORKSPACE_PKG_NOT_FOUND（apps/web 依赖 @repo/http-client）。
COPY apps/admin/package.json           ./apps/admin/
COPY apps/server/package.json          ./apps/server/
COPY apps/web/package.json             ./apps/web/
COPY packages/http-client/package.json ./packages/http-client/
COPY packages/kits/package.json        ./packages/kits/
COPY packages/sdk/package.json         ./packages/sdk/
COPY packages/shared/package.json      ./packages/shared/
COPY packages/ui/package.json          ./packages/ui/

# 安装全部依赖（含 devDependencies，build 需要）
COPY scripts/ ./scripts/
RUN pnpm install --frozen-lockfile

# 复制源码
COPY . .

# 用 turbo 构建（自动处理依赖拓扑顺序）
RUN pnpm turbo run build --filter @app/web... --filter !@app/server

# ─────────────────────────────────────────────
# Stage 2: production image (standalone)
# ─────────────────────────────────────────────
FROM node24-pnpm11:1.0 AS runner

WORKDIR /app

# standalone 产物已内嵌所需 node_modules，直接复制三样东西：
# 1. standalone 目录（含精简版 node_modules + server.js）
# 2. 静态资源
# 3. public 目录
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static     ./apps/web/.next/static
COPY --from=builder /app/apps/web/public           ./apps/web/public

# 非 root 用户运行
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
