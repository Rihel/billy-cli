{
  "name": "billy-cli",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "bootstrap": "node --import tsx/esm scripts/setup.ts",
    "seed:admin": "pnpm --filter @app/main run seed:admin",
    "dev:pkgs": "turbo run dev --filter=./packages/*",
    "build:pkgs": "turbo run build --filter=./packages/*",
    "build:web": "turbo run build --filter=@app/web...",
    "build:admin": "turbo run build --filter=@app/admin...",
    "build:main": "turbo run build --filter=@app/main...",
    "build:runtime": "turbo run build --filter=@app/agent-runtime...",
    "dev:web": "pnpm --filter @app/web run dev",
    "dev:admin": "pnpm --filter @app/admin run dev",
    "dev:main": "pnpm --filter @app/main run dev",
    "dev:runtime": "pnpm --filter @app/agent-runtime run dev",
    "dev:server": "pnpm --filter @app/main run dev",
    "dev:tools": "pnpm --parallel --filter @app/tool-gateway --filter @app/tool-worker run dev",
    "dev:stack": "pnpm --parallel --filter @app/main --filter @app/agent-runtime --filter @app/model-gateway --filter @app/tool-gateway --filter @app/tool-worker run dev",
    "start:stack": "pnpm --parallel --filter @app/main --filter @app/agent-runtime --filter @app/model-gateway --filter @app/tool-gateway --filter @app/tool-worker run start",
    "dev:tool-gateway": "pnpm --filter @app/tool-gateway run dev",
    "dev:tool-worker": "pnpm --filter @app/tool-worker run dev",
    "kill:dev": "node --import tsx/esm scripts/kill-dev.ts",
    "kill:start": "node scripts/kill-ports.ts",
    "kill:tools": "node scripts/kill-ports.ts 9992 9993 9994",
    "kill:all": "pnpm kill:dev && pnpm kill:start",
    "kill:port": "node scripts/kill-ports.ts",
    "db:gen": "pnpm --filter @repo/db run db:generate",
    "gen:tool-catalog": "tsx --tsconfig apps/agent-runtime/tsconfig.json scripts/generate-tool-catalog.ts",
    "db:migrate": "pnpm --filter @repo/db run db:migrate",
    "db:backfill-subconversations": "pnpm --filter @app/agent-runtime exec tsx scripts/backfill-subconversations.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm lint && pnpm lint:types && pnpm fmt:check && pnpm check:inject && pnpm check:mastra && pnpm check:tool-catalog && pnpm check:redis-raw && pnpm check:ui",
    "hooks:install": "lefthook install",
    "docker:up": "docker compose up -d --build",
    "start:web": "pnpm --filter @app/web run start",
    "start:admin": "pnpm --filter @app/admin run start",
    "start:main": "pnpm --filter @app/main run start",
    "start:runtime": "pnpm --filter @app/agent-runtime run start",
    "start:server": "pnpm --filter @app/main run start",
    "start:tool-gateway": "pnpm --filter @app/tool-gateway run start",
    "start:tool-worker": "pnpm --filter @app/tool-worker run start",
    "clean": "node scripts/clean.ts",
    "check:inject": "node --import tsx/esm scripts/check-inject-decorators.ts",
    "check:mastra": "node --import tsx/esm scripts/check-mastra-boundary.ts",
    "check:redis-raw": "node --import tsx/esm scripts/check-redis-raw.ts",
    "check:ui": "node --import tsx/esm scripts/check-ui.ts",
    "codegraph:setup": "node --import tsx/esm scripts/codegraph-setup.ts",
    "dev:model-gateway": "pnpm --filter @app/model-gateway run dev",
    "start:model-gateway": "pnpm --filter @app/model-gateway run start",
    "build:model-gateway": "turbo run build --filter=@app/model-gateway...",
    "check:tool-catalog": "tsx --tsconfig apps/agent-runtime/tsconfig.json scripts/check-tool-catalog.ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "lefthook": "^2.2.2",
    "oxfmt": "0.78.0",
    "reflect-metadata": "^0.2.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "picocolors": "^1.1.1",
    "turbo": "^2.11.10"
  }
}
