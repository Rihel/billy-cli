{
  "name": "billy-cli",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "bootstrap": "node --import tsx/esm scripts/setup.ts",
    "seed:admin": "pnpm --filter @app/server run seed:admin",
    "dev:pkgs": "turbo run dev --filter=./packages/*",
    "build:pkgs": "turbo run build --filter=./packages/*",
    "build:web": "turbo run build --filter=@app/web...",
    "build:admin": "turbo run build --filter=@app/admin...",
    "build:server": "turbo run build --filter=@app/server...",
    "dev:web": "pnpm --filter @app/web run dev",
    "dev:admin": "pnpm --filter @app/admin run dev",
    "dev:server": "pnpm --filter @app/server run dev",
    "kill:dev": "node --import tsx/esm scripts/kill-dev.ts",
    "kill:start": "node scripts/kill-ports.ts",
    "kill:port": "node scripts/kill-ports.ts",
    "db:gen": "pnpm --filter @app/server run db:generate",
    "db:migrate": "pnpm --filter @app/server run db:migrate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm lint && pnpm lint:types && pnpm fmt:check && pnpm check:inject && pnpm check:mastra && pnpm check:ui",
    "hooks:install": "lefthook install",
    "docker:up": "docker compose up -d --build",
    "start:web": "pnpm --filter @app/web run start",
    "start:admin": "pnpm --filter @app/admin run start",
    "start:server": "pnpm --filter @app/server run start",
    "clean": "node scripts/clean.ts",
    "check:inject": "node --import tsx/esm scripts/check-inject-decorators.ts",
    "check:mastra": "node --import tsx/esm scripts/check-mastra-boundary.ts",
    "check:ui": "node --import tsx/esm scripts/check-ui.ts",
    "codegraph:setup": "node --import tsx/esm scripts/codegraph-setup.ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "lefthook": "^2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "picocolors": "^1.1.1",
    "turbo": "^2.11.10"
  }
}
