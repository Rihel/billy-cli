{
  "name": "billy-cli",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "cli": "node --import tsx/esm scripts/cli.ts",
    "bootstrap": "node --import tsx/esm scripts/setup.ts",
    "seed:admin": "pnpm --filter @app/server run seed:admin",
    "dev:pkgs": "turbo run dev --filter=./packages/*",
    "build:pkgs": "turbo run build --filter=./packages/*",
    "dev:web": "pnpm --filter web run dev",
    "dev:admin": "pnpm --filter admin run dev",
    "dev:server": "pnpm --filter @app/server run dev",
    "kill:dev": "node --import tsx/esm scripts/kill-dev.ts",
    "db:gen": "pnpm --filter @app/server run db:generate",
    "db:migrate": "pnpm --filter @app/server run db:migrate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docker:up": "docker compose up -d --build",
    "start:web": "pnpm --filter web run start",
    "start:server": "pnpm --filter @app/server run start",
    "clean": "rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf apps/*/node_modules && rm -rf dist && rm -rf .turbo && rm -rf .next && rm -rf .cache",
    "check:inject": "node --import tsx/esm scripts/check-inject-decorators.ts",
    "check:mastra": "node --import tsx/esm scripts/check-mastra-boundary.ts",
    "check:scaffold": "node --import tsx/esm scripts/check-scaffold-templates.ts",
    "check:ui": "node --import tsx/esm scripts/check-ui.ts",
    "codegraph:setup": "node --import tsx/esm scripts/codegraph-setup.ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "license": "ISC",
  "dependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "eta": "^4.6.0",
    "picocolors": "^1.1.1",
    "turbo": "^2.11.10"
  }
}
