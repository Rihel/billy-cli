{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "sortImports": false,
  "ignorePatterns": [
    "**/*.md",
    "pnpm-lock.yaml",
    "apps/web/next-env.d.ts",
    "apps/admin/public/vendor/**",
    "**/*.min.js",
    "**/dist/**",
    "**/.next/**"
  ]
}
