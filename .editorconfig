# 编辑器基础约定（oxfmt 会读取 indent_style / indent_size / max_line_length / end_of_line）
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# 文档手写断行，不让编辑器/格式化器重排
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
