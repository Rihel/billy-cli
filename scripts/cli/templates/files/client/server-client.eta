import { createAppClients } from '@repo/sdk'
import { Pages, PublicServerUrl, ServerUrl, TokenKey } from './constants'

/**
 * 应用侧 HTTP 客户端装配。
 *
 * 机制（浏览器端单例 / 服务端无状态客户端 / 凭证读写 / 401 清理凭证）在 `@repo/sdk` 的
 * `createAppClients`；这里只注入本应用的取值与**应用独有**的 401 善后策略，
 * 不需要自己 new `ServerClient` 或挑凭证管理器。
 *
 * 401 善后：默认回 `Pages.home`；有登录页后改成跳登录页（并可带 `?next=` 回跳）。
 */
export const {
  getServerClient,
  useServerClient,
  createServerClient,
  saveToken,
  removeToken,
} = createAppClients({
  tokenKey: TokenKey,
  publicBaseUrl: PublicServerUrl,
  serverBaseUrl: ServerUrl,
  onUnauthorized: () => {
    if (typeof window === 'undefined') return
    window.location.replace(Pages.home)
  },
})
