import {
  Transactional,
  type CursorQueryResult,
  type PageQueryResult,
} from '@repo/kits'
import type {
  Create<%= it.modulePascal %>Dto,
  CursorQuery<%= it.modulePascal %>Dto,
  GetDetail<%= it.modulePascal %>Dto,
  PageQuery<%= it.modulePascal %>Dto,
  Remove<%= it.modulePascal %>Dto,
  <%= it.modulePascal %>CursorModel,
  <%= it.modulePascal %>Model,
  Update<%= it.modulePascal %>Dto,
} from '@repo/shared'
import { Inject, Injectable } from '@nestjs/common'
import { AppLogger } from '@repo/kits'
import { <%= it.modulePascal %>Repository } from './<%= it.name %>.repository.js'
import { <%= it.modulePascal %>NotFoundError } from './errors.js'

@Injectable()
export class <%= it.modulePascal %>Service {
  constructor(
    @Inject(<%= it.modulePascal %>Repository) private readonly <%= it.name %>Repository: <%= it.modulePascal %>Repository,
    @Inject(AppLogger) private readonly logger: AppLogger,
  ) {}

  @Transactional()
  async create(input: Create<%= it.modulePascal %>Dto): Promise<<%= it.modulePascal %>Model> {
    const <%= it.name %> = await this.<%= it.name %>Repository.create(input)
    this.logger.log('<%= it.name %>.created', { id: <%= it.name %>.id })
    return <%= it.name %>
  }

  async get(input: GetDetail<%= it.modulePascal %>Dto): Promise<<%= it.modulePascal %>Model> {
    const <%= it.name %> = await this.<%= it.name %>Repository.findById(input.<%= it.name %>Id)
    if (!<%= it.name %>) throw new <%= it.modulePascal %>NotFoundError(input.<%= it.name %>Id)
    return <%= it.name %>
  }

  async page(query: PageQuery<%= it.modulePascal %>Dto): Promise<PageQueryResult<<%= it.modulePascal %>Model>> {
    return this.<%= it.name %>Repository.page(query)
  }

  async cursor(
    query: CursorQuery<%= it.modulePascal %>Dto,
  ): Promise<CursorQueryResult<<%= it.modulePascal %>Model, <%= it.modulePascal %>CursorModel>> {
    return this.<%= it.name %>Repository.cursor(query)
  }

  @Transactional()
  async update(input: Update<%= it.modulePascal %>Dto): Promise<<%= it.modulePascal %>Model> {
    const { <%= it.name %>Id, ...changes } = input
    const <%= it.name %> = await this.<%= it.name %>Repository.update(<%= it.name %>Id, changes)
    if (!<%= it.name %>) throw new <%= it.modulePascal %>NotFoundError(<%= it.name %>Id)
    this.logger.log('<%= it.name %>.updated', { id: <%= it.name %>Id })
    return <%= it.name %>
  }

  @Transactional()
  async remove(input: Remove<%= it.modulePascal %>Dto): Promise<<%= it.modulePascal %>Model> {
    const <%= it.name %> = await this.<%= it.name %>Repository.remove(input.<%= it.name %>Id)
    if (!<%= it.name %>) throw new <%= it.modulePascal %>NotFoundError(input.<%= it.name %>Id)
    this.logger.log('<%= it.name %>.removed', { id: input.<%= it.name %>Id })
    return <%= it.name %>
  }
}
