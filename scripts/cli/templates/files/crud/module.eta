import { Module } from '@nestjs/common'
import { AdminModule } from '../admin/admin.module.js'
import { <%= it.modulePascal %>Controller } from './<%= it.name %>.controller.js'
import { <%= it.modulePascal %>Repository } from './<%= it.name %>.repository.js'
import { <%= it.modulePascal %>Service } from './<%= it.name %>.service.js'

/**
 * <%= it.modulePascal %> 模块：repository / service（业务）+ controller（HTTP 边界）。
 * 放在 modules/<%= it.name %>/ 下（NestJS 惯例：一个业务模块一个目录）。
 * 用到别的模块能力时在 imports 中添加对方模块（其 provider 需已被 exports）。
 */
@Module({
  imports: [AdminModule],
  controllers: [<%= it.modulePascal %>Controller],
  providers: [<%= it.modulePascal %>Repository, <%= it.modulePascal %>Service],
})
export class <%= it.modulePascal %>Module {}
