import 'reflect-metadata'
import 'dotenv/config'
import { ConfigService } from '@nestjs/config'
import { NestFactory } from '@nestjs/core'
import type { NestExpressApplication } from '@nestjs/platform-express'
import { NestLoggerAdapter } from '@repo/kits'
import { RootModule } from './root.module.js'
import { loadAppConfig } from './app-config.js'
import { resolveServerConfig } from './config.js'

/**
 * 应用入口（NestJS 12 + Express）：
 * 1. 创建应用容器（RootModule 为唯一组合根）；
 * 2. 注册横切中间件（如需请求上下文 / 日志，参照 apps/server/src/common/ 实现后在此 app.use）；
 * 3. 监听端口；收到 SIGINT / SIGTERM 时优雅关闭。
 *
 * 注意：开发用 tsx（esbuild）不产出 design:paramtypes，所有构造器参数必须显式 @Inject(token)。
 */
export const program = async (): Promise<void> => {
  // 先加载并校验应用配置，再创建应用（各模块 forRootAsync 工厂会读这份缓存）
  await loadAppConfig()

  const app = await NestFactory.create<NestExpressApplication>(RootModule, {
    bodyParser: false,
    // 先缓冲启动期日志，useLogger 之后统一由自建 pino logger（NestLoggerAdapter）输出
    bufferLogs: true,
  })
  app.useLogger(app.get(NestLoggerAdapter))
  const logger = app.get(NestLoggerAdapter)
  app.enableCors()
  app.disable('x-powered-by')
  app.useBodyParser('json', { limit: '2mb' })
  app.useBodyParser('urlencoded', { limit: '2mb', extended: true })

  const config = resolveServerConfig(app.get(ConfigService))

  // 空闲长连接 / 请求头超时：必须比前置网关（Kong 等）的**上游空闲超时**更长，否则网关会在
  // 「它以为连接还能复用」的窗口里往已关闭的 socket 发请求 → 间歇 502（后端日志无痕，
  // 因为请求没到应用）。默认 75s / 80s 及来由见 app-config.ts，可用
  // KEEP_ALIVE_TIMEOUT_MS / HEADERS_TIMEOUT_MS 覆盖。
  const httpServer = app.getHttpServer()
  httpServer.keepAliveTimeout = config.keepAliveTimeoutMs
  httpServer.headersTimeout = config.headersTimeoutMs

  await app.listen(config.port)
  logger.log(`服务已启动: http://localhost:${config.port}`, 'bootstrap')

  let closing = false
  const shutdown = async (signal: string): Promise<void> => {
    if (closing) return
    closing = true
    logger.log(`收到 ${signal}，正在关闭服务...`, 'bootstrap')
    try {
      await app.close()
      logger.log('服务已关闭', 'bootstrap')
    } catch (error) {
      logger.error(error, '关闭资源失败', 'bootstrap')
    }
    process.exit(0)
  }
  process.once('SIGINT', () => void shutdown('SIGINT'))
  process.once('SIGTERM', () => void shutdown('SIGTERM'))
}

void program()
