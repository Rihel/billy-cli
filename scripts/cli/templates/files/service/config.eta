import type { ConfigService } from '@nestjs/config'
import type { AppConfig } from './app-config.js'

/**
 * 应用级业务配置：即应用配置的 `server` 分片（端口、业务策略等）。
 *
 * 不属于 kits 能力配置，由本应用自行定义，取值统一来自 app-config 加载并校验过的应用配置。
 */
export type ServerConfig = AppConfig['server']

/**
 * 取应用级业务配置：配置由 bootstrap 首行的 `loadAppConfig()` 加载 + 校验 + 补默认值，
 * 再经 `AppConfigModule` 接进全局 `ConfigService`；各消费方注入 `ConfigService` 后惰性取自己的分片，
 * 不单设配置 bean/module。用 `getOrThrow`：走到这里配置必已加载，缺失即装配错误。
 */
export const resolveServerConfig = (config: ConfigService): ServerConfig =>
  config.getOrThrow<ServerConfig>('server')
